# Production database. Replit Database creates this automatically.
DATABASE_URL=

# Use a long random value in every deployed environment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Exact public origin, without a trailing slash.
# Example: https://tip-tap-games.replit.app
PUBLIC_BASE_URL=http://localhost:3000

# Optional OAuth providers. The app stays guest-first when these are omitted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Android TWA (installable APK). Fill these AFTER building the APK with PWABuilder
# to hide the browser URL bar. Leaving them empty is fine — the app still works.
# ANDROID_CERT_FINGERPRINTS is a comma-separated list of SHA-256 fingerprints.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_FINGERPRINTS=

PORT=3000
