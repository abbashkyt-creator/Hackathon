# Production database. Replit Database creates this automatically.
DATABASE_URL=

# Use a long random value in every deployed environment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Exact public origin, without a trailing slash.
# Example: https://tip-tap-games.replit.app
PUBLIC_BASE_URL=http://localhost:3000

# Optional OAuth providers. The app stays guest-first when these are omitted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

PORT=3000
