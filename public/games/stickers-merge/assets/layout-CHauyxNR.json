            "components": {
              "responsivePosition": {
                "type": "ResponsiveNodePositionComponent",
                "enabled": true,
                "data": {
                  "mode": "screen",
                  "position": {
                    "cx": 0,
                    "cy": "25%"
                  }
                }
              }
            },
            "children": {
              "content": {
                "$include": "json/layouts/features/shared-ui/_transition-loading-indicator.json"
              }
            }
          },
          "playButtonContainer": {
            "type": "Container",
            "props": {
              "x": 0,
              "y": 0
            },
            "components": {
              "responsivePosition": {
                "type": "ResponsiveNodePositionComponent",
                "enabled": true,
                "data": {
                  "mode": "screen",
                  "position": {
                    "cx": 0,
                    "cy": "25%"
                  }
                }
              },
              "responsiveSize": {
                "type": "ResponsiveNodeSizeComponent",
                "enabled": true,
                "data": {
                  "mode": "uniform_scale",
                  "minScale": 0.74,
                  "maxScale": 1,
                  "uniform": {
                    "axis": "min",
                    "referenceScreenWidthPx": 720,
                    "referenceScreenHeightPx": 1280
                  }
                }
              }
            },
            "children": {
              "playButton": {
                "type": "Sprite",
                "props": {
                  "asset": "images/common/btn1.png",
                  "x": 0,
                  "y": 0,
                  "visible": false,
                  "anchor": {
                    "x": 0.5,
                    "y": 0.5
                  }
                },
                "actions": {
                  "playButtonReveal": {
                    "type": "PlayButtonRevealAction",
                    "data": {
                      "durationMs": 420,
                      "ease": "back.out(1.7)",
                      "targetScale": 1.5
                    }
                  },
                  "playButtonStartIdleLoop": {
                    "type": "PlayButtonStartIdleLoopAction",
                    "data": {
                      "durationMs": 1100,
                      "minScale": 1.3,
                      "startScale": 1.5,
                      "ease": "sine.inOut"
                    }
                  },
                  "playButtonStopAnimations": {
                    "type": "PlayButtonStopAnimationsAction"
                  },
                  "playButtonTapPress": {
                    "type": "PlayButtonTapPressAction",
                    "data": {
                      "downDurationMs": 70,
                      "upDurationMs": 90,
                      "pressedScale": 0.9,
                      "baseScale": 1.5,
                      "downEase": "power2.out",
                      "upEase": "power2.out"
                    }
                  }
                },
                "components": {
                  "glintOverlay": {
                    "type": "GlintOverlayComponent",
                    "enabled": true,
                    "data": {
                      "overlayAssetId": "images/common/btnMainWhite.png",
                      "intervalMs": 2000,
                      "moveDurationMs": 400,
                      "fadeInDurationMs": 180,
                      "fadeOutDurationMs": 320,
                      "peakAlpha": 0.2,
                      "skewX": -0.36,
                      "widthRatio": 0.34,
                      "blendMode": "add"
                    }
                  },
                  "bootPlayButton": {
                    "type": "BootPlayButtonComponent",
                    "enabled": true
                  }
                },
                "children": {
                  "label": {
                    "type": "Text",
                    "props": {
                      "textKey": "item.play",
                      "x": 0,
                      "y": 0,
                      "anchor": {
                        "x": 0.5,
                        "y": 0.5
                      },
                      "style": "introAnimationContinueButtonText"
                    }
                  }
                }
              }
            }
          }
        }
