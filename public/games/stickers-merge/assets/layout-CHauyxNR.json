{
  "root": {
    "type": "Container",
    "children": {
      "background": {
        "type": "Container",
        "components": {
          "responsiveNodeSize": {
            "type": "ResponsiveNodeSizeComponent",
            "enabled": true,
            "data": {
              "mode": "fill_width_height_ratio",
              "minScale": 1,
              "maxScale": 1,
              "fill": {
                "resizeTargets": [
                  "gradient",
                  "pattern"
                ],
                "widthPercent": 1,
                "heightRatio": 1,
                "minHeightPx": 1,
                "maxHeightPx": 5000,
                "horizontalAlign": "left",
                "verticalAlign": "top"
              }
            }
          }
        },
        "children": {
          "gradient": {
            "type": "Sprite",
            "props": {
              "asset": "images/common/bg-gradient.png",
              "anchor": {
                "x": 0,
                "y": 0
              }
            }
          },
          "pattern": {
            "type": "TilingSprite",
            "props": {
              "asset": "images/common/pattern.png",
              "anchor": {
                "x": 0,
                "y": 0
              }
            }
          }
        }
      },
      "content": {
        "type": "Container",
        "children": {
          "playfield": {
            "type": "Container",
            "props": {
              "x": 0,
              "y": 0
            },
            "components": {
              "bootIntroAnimationPresentation": {
                "type": "BootIntroAnimationPresentationComponent",
                "enabled": true,
                "data": {}
              }
            },
            "children": {
              "stickersArea": {
                "type": "Container",
                "props": {
                  "x": 0,
                  "y": 0
                },
                "components": {
                  "responsivePosition": {
                    "type": "ResponsiveNodePositionComponent",
                    "enabled": true,
                    "data": {
                      "mode": "screen",
                      "position": {
                        "cx": 0,
                        "cy": 0
                      }
                    }
                  },
                  "responsiveSize": {
                    "type": "ResponsiveNodeSizeComponent",
                    "enabled": true,
                    "data": {
                      "mode": "uniform_scale",
                      "minScale": 0.68,
                      "maxScale": 1,
                      "uniform": {
                        "axis": "min",
                        "referenceScreenWidthPx": 720,
                        "referenceScreenHeightPx": 1280
                      }
                    }
                  }
                },
                "children": {
                  "titleLogo": {
                    "type": "Sprite",
                    "actions": {
                      "logoReveal": {
                        "type": "PlayButtonRevealAction",
                        "data": {
                          "durationMs": 420,
                          "ease": "back.out(1.7)"
                        }
                      }
                    },
                    "components": {
                      "responsivePosition": {
                        "type": "ResponsiveNodePositionComponent",
                        "enabled": true,
                        "data": {
                          "mode": "screen",
                          "position": {
                            "cx": 0,
                            "cy": "-28%"
                          }
                        }
                      },
                      "responsiveSize": {
                        "type": "ResponsiveNodeSizeComponent",
                        "enabled": true,
                        "data": {
                          "mode": "uniform_scale",
                          "minScale": 0.72,
                          "maxScale": 1,
                          "uniform": {
                            "axis": "min",
                            "referenceScreenWidthPx": 720,
                            "referenceScreenHeightPx": 1280
                          }
                        }
                      }
                    },
                    "props": {
                      "assetByLocale": {
                        "en": "images/common/logo_en.png",
                        "ru": "images/common/logo_ru.png"
                      },
                      "x": 0,
                      "y": 0,
                      "anchor": {
                        "x": 0.5,
                        "y": 0.5
                      }
                    }
                  },
                  "leftStickerSlot": {
                    "type": "Container",
                    "props": {
                      "x": -140,
                      "y": 0,
                      "visible": false
                    },
                    "children": {
                      "tier1": {
                        "type": "Container",
                        "children": {
                          "sprite": {
                            "type": "Sprite",
                            "props": {
                              "asset": "images/stickers/02/01_1.png",
                              "anchor": {
                                "x": 0.5,
                                "y": 0.5
                              },
                              "scale": 0.5
                            }
                          }
                        }
                      },
                      "tier2": {
                        "type": "Container",
                        "props": {
                          "visible": false
                        },
                        "children": {
                          "sprite": {
                            "type": "Sprite",
                            "props": {
                              "asset": "images/stickers/02/01_2.png",
                              "anchor": {
                                "x": 0.5,
                                "y": 0.5
                              },
                              "scale": 0.5
                            }
                          }
                        }
                      },
                      "tier3": {
                        "type": "Container",
                        "props": {
                          "visible": false
                        },
                        "children": {
                          "sprite": {
                            "type": "Sprite",
                            "props": {
                              "asset": "images/stickers/02/01_3.png",
                              "anchor": {
                                "x": 0.5,
                                "y": 0.5
                              },
                              "scale": 0.5
                            }
                          }
                        }
                      }
                    }
                  },
                  "rightStickerSlot": {
                    "type": "Container",
                    "props": {
                      "x": 140,
                      "y": 0,
                      "visible": false
                    },
                    "actions": {
                      "upgradeTween": {
                        "type": "StickerUpgradeTweenAction"
                      }
                    },
                    "children": {
                      "tier1": {
                        "type": "Container",
                        "children": {
                          "sprite": {
                            "type": "Sprite",
                            "props": {
                              "asset": "images/stickers/02/01_1.png",
                              "anchor": {
                                "x": 0.5,
                                "y": 0.5
                              },
                              "scale": 0.5
                            }
                          }
                        }
                      },
                      "tier2": {
                        "type": "Container",
                        "props": {
                          "visible": false
                        },
                        "children": {
                          "sprite": {
                            "type": "Sprite",
                            "props": {
                              "asset": "images/stickers/02/01_2.png",
                              "anchor": {
                                "x": 0.5,
                                "y": 0.5
                              },
                              "scale": 0.5
                            }
                          }
                        }
                      },
                      "tier3": {
                        "type": "Container",
                        "props": {
                          "visible": false
                        },
                        "children": {
                          "sprite": {
                            "type": "Sprite",
                            "props": {
                              "asset": "images/stickers/02/01_3.png",
                              "anchor": {
                                "x": 0.5,
                                "y": 0.5
                              },
                              "scale": 0.5
                            }
                          }
                        }
                      }
                    }
                  },
                  "particlesLayer": {
                    "type": "Container",
                    "children": {
                      "mergeParticlesContainer": {
                        "type": "Container",
                        "actions": {
                          "playMergeImpact": {
                            "type": "DefaultMergeImpactAction",
                            "data": {
                              "textureAssetId": "images/common/flash.png",
                              "burstPresetAssetId": "json/configs/scenes/level/particles/default-merge-impact-burst.json",
                              "glowExpandDurationMs": 200,
                              "glowCollapseDurationMs": 100,
                              "sparkleDelayMs": 60,
                              "sparkleExpandDurationMs": 200,
                              "sparkleCollapseDurationMs": 200,
                              "fxDurationMs": 260
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "handLayer": {
                "type": "Container"
              },
              "dragOverlay": {
                "type": "Container",
                "props": {
                  "x": 0,
                  "y": 0
                },
                "components": {
                  "responsivePosition": {
                    "type": "ResponsiveNodePositionComponent",
                    "enabled": true,
                    "data": {
                      "mode": "screen",
                      "position": {
                        "cx": 0,
                        "cy": 0
                      }
                    }
                  },
                  "responsiveSize": {
                    "type": "ResponsiveNodeSizeComponent",
                    "enabled": true,
                    "data": {
                      "mode": "uniform_scale",
                      "minScale": 0.68,
                      "maxScale": 1,
                      "uniform": {
                        "axis": "min",
                        "referenceScreenWidthPx": 720,
                        "referenceScreenHeightPx": 1280
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ui": {
        "type": "Container",
        "props": {
          "x": 0,
          "y": 0
