{
  "name": "tip-tap-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An infinite, mobile-first feed of instant one-thumb mini games.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && node scripts/stamp-sw-build.mjs && node scripts/prune-retired-ruffle-assets.mjs && node scripts/precompress-game-assets.mjs && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:release": "node scripts/audit-release.mjs",
    "check": "npm run audit:release && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lucide-react": "1.26.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.4",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
